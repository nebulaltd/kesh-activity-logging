PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/logs.db
API_KEY=change-me
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576

# off      = never pull (default; use on any instance that only serves queries)
# interval = the always-on server polls itself every LOG_PULL_INTERVAL_MS
# oneshot  = only scripts/pull-activity-logs.sh pulls, driven by cron
LOG_PULL_MODE=off

# Single-source shorthand. Prefer the indexed form below when there is more than one origin.
LOG_PULL_SOURCE_URL=
LOG_PULL_API_KEY=

# Indexed sources. Every _URL needs a matching _API_KEY; _NAME defaults to source-<n>.
# The name is stored as remote_source on every row, so keep it stable and meaningful.
# LOG_PULL_SOURCE_1_NAME=aws-live
# LOG_PULL_SOURCE_1_URL=http://127.0.0.1:5055/internal/activity-logs
# LOG_PULL_SOURCE_1_API_KEY=
# LOG_PULL_SOURCE_2_NAME=onprem
# LOG_PULL_SOURCE_2_URL=http://127.0.0.1:5050/internal/activity-logs
# LOG_PULL_SOURCE_2_API_KEY=

LOG_PULL_INTERVAL_MS=60000
LOG_PULL_BATCH_SIZE=500
LOG_PULL_MAX_ITERATIONS=20

# Optional dead-man switch pinged after a successful run.
LOG_PULL_HEARTBEAT_URL=

# Cron schedule rendered by scripts/install-cron.sh. Keep the quotes.
LOG_PULL_CRON_SCHEDULE="*/5 * * * *"

# Absolute path to bun. Cron does not inherit your shell PATH.
BUN_BIN=

# SSH tunnel to the live kesh-back. Leave PULL_SSH_HOST empty for direct access.
PULL_SSH_HOST=
PULL_SSH_USER=
PULL_SSH_KEY=
PULL_SSH_PORT=
PULL_SSH_LOCAL_PORT=5055
PULL_SSH_REMOTE_HOST=127.0.0.1
PULL_SSH_REMOTE_PORT=5050

# Failure alerts from scripts/pull-activity-logs.sh.
PULL_ALERT_EMAIL=
